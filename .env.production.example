# Copy to .env on the VPS only; never commit the real file.
DOMAIN=erudi.synapseengineering.dev
# Generate with: openssl rand -hex 32  (hex keeps the connection string valid;
# deploy/create-database.sh refuses anything else)
ERUDI_DB_PASSWORD=change-me
DATABASE_POOL_SIZE=5
# Sign-in goes through the Synapse identity service (synapse-auth). The same
# value as ERUDI_CLIENT_SECRET in its .env (node deploy/generate-secrets.mjs).
IDENTITY_CLIENT_SECRET=change-me
# Docker networks of Plano's stack and of Mailcow (docker network ls)
PLANO_NETWORK=plano-prod_default
MAILCOW_NETWORK=mailcowdockerized_mailcow-network
