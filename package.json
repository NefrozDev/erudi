{
  "name": "erudi",
  "private": true,
  "scripts": {
    "db:start": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "start:front": "npm --prefix frontend start",
    "start:back": "dotnet watch --project backend/src/Erudi.Api --launch-profile http",
    "lint:front": "npm --prefix frontend run lint",
    "lint:back": "dotnet format backend/Erudi.slnx --verify-no-changes",
    "lint": "npm run lint:front && npm run lint:back",
    "test:front": "npm --prefix frontend test -- --watch=false",
    "test:back": "cd backend && dotnet test --solution Erudi.slnx",
    "test": "npm run test:front && npm run test:back",
    "build:front": "npm --prefix frontend run build",
    "build:back": "dotnet build backend/Erudi.slnx -c Release",
    "build": "npm run build:front && npm run build:back"
  }
}
